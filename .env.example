# Copy to .env and fill in. .env is gitignored; this file is not.

# Decomposition model — any OpenAI-compatible chat endpoint.
# It only marks line ranges and writes metadata; it never authors instruction
# text, so a cheap model is a deliberate choice rather than a compromise.
#
# NOTE: ingest sends each skill document to this endpoint IN FULL. For public
# upstream skills that is what they are. Before pointing this at a hosted
# provider, check that nothing in --source is internal: this is the one place
# in the pipeline where private text would leave the machine.
#
# llm_model_fallback is optional. When set, a model that errors out or returns
# unparseable output is retried once on the second model, and the catalogue
# records which one answered.
llm_base_url=https://example.com/api/v1
llm_model=openai/gpt-5.6-luna-pro
llm_model_fallback=qwen/qwen3.6-flash
llm_api_key=api_key_example

# Embedding model — OpenAI-compatible /embeddings.
# embedder_dim is the vector width, not the model's context length: bge-base
# is 768 wide with a 512-token window, and the two get confused. It is
# asserted twice — against what the server returns, and against the index
# already on disk — because a query and an index built by different models
# score against each other silently and answer with confident nonsense.
#
# bge-base over bge-small was measured on scripts/eval_retrieval.py, not
# assumed: gated 17/17 against 16/17, and the pool the reranker sees is built
# by the dense pass, so dense recall at depth is what decides whether a part
# can be rescued at all. Changing this means rebuilding the index.
embedder_base_url=http://localhost:1234/v1
embedder_model=text-embedding-bge-base-en-v1.5
embedder_dim=768
embedder_api_key=sk-replace-me

# Second ranking pass: how the 20 dense candidates become the answer.
#
#   cross-encoder  scores each candidate against the query on its own. Local,
#                  needs no endpoint, works out of the box. This is the
#                  default because it is the one that asks nothing of you.
#   llm            shows one instruction-tuned model the whole numbered pool
#                  and takes back an ordering. Needs the three settings below.
#
# Measured on 34 paired queries (scripts/eval_retrieval.py; "concrete" is the
# axis where the need carries a real project's proper nouns, which is the only
# register that occurs in production):
#
#                                 need   concrete  total   s/query
#   cross-encoder MiniLM-L-12     16/17    14/17   30/34    0.09
#   cross-encoder bge-base        15/17    10/17   25/34    0.33
#   cross-encoder bge-v2-m3 (Q4)  15/17    14/17   29/34    1.40
#   llm gemma-4-e2b-it-qat        16/17    16/17   32/34    0.23
#
# The llm pass wins where it was expected to and does not lose elsewhere: a
# cross-encoder compares strings and cannot tell that "keeping a Stripe call
# from hanging" is a resilience need, while an instruction-tuned model can.
# Two stronger cross-encoders were tried first and both lost — the fix was
# never a bigger model of the same shape.
#
# Note the shape matters more than the model: asked to score candidates one at
# a time with a digit, the same gemma scored 23/34. Shown all twenty at once,
# 32/34. Small models have no stable absolute scale; comparison needs none.
#
# NOTE: cross-encoder takes a local model NAME, not a URL — it reads a
# (query, passage) pair in one forward pass and no OpenAI-compatible server
# exposes that. LM Studio has no rerank endpoint. Pointing embedder_model at a
# reranker is the trap: it answers 200 with 1024-wide vectors pooled out of an
# encoder never trained for pooling, every guard passes, and retrieval quietly
# degrades.
reranker_kind=cross-encoder
reranker_model=cross-encoder/ms-marco-MiniLM-L-12-v2

# Required only when reranker_kind=llm. Deliberately not llm_base_url above:
# that is the hosted model that decomposes skills, and it runs once per skill.
# This one runs on every search, so it wants to be local and free.
# reranker_kind=llm
# reranker_base_url=http://localhost:1234/v1
# reranker_model=gemma-4-e2b-it-qat
# reranker_api_key=sk-replace-me

# Fraction of a skill's lines that must end up inside some part.
# Below this the decomposition is assumed to have dropped content.
min_coverage=0.5

# Where sources.yaml resolves relative paths from. Absolute paths and ~ in the
# manifest ignore this. Keeping it here is what lets the manifest be committed
# unchanged across machines.
sources_root=C:/Users/you/repos
