# Copy to .env and fill in. .env is gitignored; this file is not.

# Decomposition model — any OpenAI-compatible chat endpoint.
# It only marks line ranges and writes metadata; it never authors instruction
# text, so a cheap model is a deliberate choice rather than a compromise.
#
# NOTE: ingest sends each skill document to this endpoint IN FULL. For public
# upstream skills that is what they are. Before pointing this at a hosted
# provider, check that nothing in --source is internal: this is the one place
# in the pipeline where private text would leave the machine.
#
# llm_model_fallback is optional. When set, a model that errors out or returns
# unparseable output is retried once on the second model, and the catalogue
# records which one answered.
llm_base_url=https://example.com/api/v1
llm_model=openai/gpt-5.6-luna-pro
llm_model_fallback=qwen/qwen3.6-flash
llm_api_key=api_key_example

# Embedding model — OpenAI-compatible /embeddings.
# embedder_dim is the vector width, not the model's context length: bge-base
# is 768 wide with a 512-token window, and the two get confused. It is
# asserted twice — against what the server returns, and against the index
# already on disk — because a query and an index built by different models
# score against each other silently and answer with confident nonsense.
#
# bge-base over bge-small was measured on scripts/eval_retrieval.py, not
# assumed: gated 17/17 against 16/17, and the pool the reranker sees is built
# by the dense pass, so dense recall at depth is what decides whether a part
# can be rescued at all. Changing this means rebuilding the index.
# Use the IPv4 literal, not `localhost`. On Windows `localhost` resolves to
# ::1 first; if the server listens on IPv4 only, every request pays a failed
# connection and a retry before it starts. Measured 2026-08-03: 2.15s per call
# against 0.11s, and a whole find_lenses 4.4s against 0.47s. It looks exactly
# like a slow model - a three-token prompt cost the same 2.1s as a real one -
# which is why it went unnoticed through two model changes.
embedder_base_url=http://127.0.0.1:1234/v1
embedder_model=text-embedding-bge-base-en-v1.5
embedder_dim=768
embedder_api_key=sk-replace-me

# Second ranking pass: how the 20 dense candidates become the answer.
#
# All three settings or none. Configure them and one instruction-tuned model
# is shown the whole numbered pool and asked which are best; leave them out
# and the dense ordering is the answer, which is a supported way to run this.
# Setting one of the three and not the others fails at load rather than
# searching without the pass you asked for.
#
# Deliberately not llm_base_url above: that is the hosted model that
# decomposes skills and runs once per skill. This one runs on every search,
# so it wants to be local and free. It is probed once at startup, so a wrong
# URL is a server that does not start rather than one that quietly answers
# worse than it says it does.
#
# Measured 2026-08-03 on 34 paired needs (scripts/eval_retrieval.py;
# "concrete" is the axis where the need carries a real project's proper
# nouns, which is the only register that occurs in production):
#
#                                 need   concrete  total   s/query
#   no second pass                33/34    27/34   60/68     0
#   llm gemma-4-e2b-it-qat        32/34    33/34   65/68     0.23
#
# A cross-encoder pass was tried and retired on 2026-08-03 at 57/68 - below
# having no second pass at all. It also required sentence-transformers, and
# therefore torch, for one import. See README, "What is not settled".
# reranker_base_url=http://127.0.0.1:1234/v1
# reranker_model=gemma-4-e2b-it-qat
# reranker_api_key=sk-replace-me

# Optional: a second model on the SAME server for classifying a need against
# catalog/taxonomy.yaml. Leave it unset unless you have measured a reason.
#
# It looked necessary: classifying an out-of-corpus need is 8/8 on
# gemma-4-e4b-it-qat and 2/5 on e2b, while both rank at 65/68 and e2b appeared
# ten times faster. Measured 2026-08-03, the speed half is false - this server
# costs ~2.1s of fixed overhead per request whatever the model or prompt (a
# three-token prompt to either gemma, and a one-word embedding on bge-base,
# all land within 0.1s of each other), so e2b and e4b rank in 2.25s and 2.32s
# and splitting gains nothing. One model, the 4B, does both jobs.
# classifier_model=gemma-4-e4b-it-qat

# Fraction of a skill's lines that must end up inside some part.
# Below this the decomposition is assumed to have dropped content.
min_coverage=0.5

# Where sources.yaml resolves relative paths from. Absolute paths and ~ in the
# manifest ignore this. Keeping it here is what lets the manifest be committed
# unchanged across machines.
sources_root=C:/Users/you/repos
